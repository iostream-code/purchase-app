<?xml version='1.0' encoding='utf-8'?>
<widget id="com.purchase.app" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>Purchase App</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Korin Team
    </author>

    <!-- Entry point: arahkan ke halaman login, bukan index.html -->
    <content src="pages/login.html" />

    <!-- Izinkan navigasi ke file lokal (wajib untuk Cordova file:// mode) -->
    <allow-navigation href="file:///*" />
    <allow-navigation href="about:*" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

</widget>